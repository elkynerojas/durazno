# Copia este archivo como .env y ajusta los valores. El archivo .env NO se
# sube a Git.

# --- Base de datos (PostgreSQL 18 + PostGIS 3.6) ---
# Si cambias usuario o base, actualiza también db/pgadmin/servers.json.
POSTGRES_USER=icota
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=durazno_icota
# Puerto en tu equipo (cámbialo si ya tienes un PostgreSQL local en 5432).
POSTGRES_PORT_HOST=5432

# --- API (FastAPI, publicada por nginx) ---
# Puerto de nginx en tu equipo (cámbialo si el 80 ya está ocupado).
NGINX_PORT=80
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
# Clave para firmar los tokens de sesión. Genérela con: openssl rand -hex 32
SECRET_KEY=cambie_esta_clave_secreta
# Duración de la sesión en minutos.
TOKEN_MINUTOS=720

# --- Frontend (React + Vite) ---
FRONTEND_PORT=5173
# true en Windows/macOS para que funcione la recarga en caliente en Docker.
VITE_USE_POLLING=true

# --- Pruebas E2E (Playwright) ---
# Usuario que crea `docker compose exec api python -m app.scripts.sembrar_e2e`.
E2E_USUARIO=e2e-agronomo
E2E_CLAVE=cambie_esta_clave_e2e

# --- pgAdmin ---
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
