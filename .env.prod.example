# Producción (docker-compose.prod.yml). Copie este archivo como .env EN EL SERVIDOR y reemplace
# cada valor. Genere las claves con: openssl rand -hex 32

# --- Dominio y certificado (HU-08) ---
# Dominio o subdominio que apunta a la IP pública del servidor.
DOMINIO=icota.ejemplo.co
# Correo al que Let's Encrypt avisa de certificados por vencer.
CORREO_LETSENCRYPT=responsable@ejemplo.co
# Puertos publicados (deje 80 y 443 en el servidor).
HTTP_PUERTO=80
HTTPS_PUERTO=443

# --- Base de datos ---
POSTGRES_USER=icota
POSTGRES_PASSWORD=cambie_por_una_clave_larga_y_aleatoria
POSTGRES_DB=durazno_icota
# Días que se conservan las copias diarias (deploy/respaldo).
DIAS_RETENCION=14

# --- API ---
ENVIRONMENT=production
SECRET_KEY=cambie_por_64_caracteres_de_openssl_rand_hex_32
CORS_ORIGINS=https://icota.ejemplo.co
# El QR de cada trampa codifica <QR_URL_BASE>/t/<código>. Debe usar https://.
QR_URL_BASE=https://icota.ejemplo.co
TOKEN_MINUTOS=15
RENOVACION_DIAS=7
SESION_MAX_DIAS=30
INTENTOS_MAXIMOS=5
INTENTOS_VENTANA_MINUTOS=15

# --- Red interna de Docker (cámbiela solo si choca con otra red del servidor) ---
# RED_INTERNA=10.231.0.0/24
# IP_NGINX=10.231.0.10
