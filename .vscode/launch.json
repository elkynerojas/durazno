{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: adjuntar depurador (Docker)",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "localhost", "port": 5678 },
      "pathMappings": [{ "localRoot": "${workspaceFolder}/backend", "remoteRoot": "/app" }],
      "justMyCode": true,
      "preLaunchTask": "Docker: levantar API en modo depuración"
    },
    {
      "name": "Frontend: abrir en Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src"
    }
  ]
}
