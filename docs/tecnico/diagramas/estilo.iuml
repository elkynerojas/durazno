' Estilo común de los diagramas de SIDURAF (colores del aplicativo).
skinparam dpi 160
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam backgroundColor white
skinparam roundCorner 8
skinparam ArrowColor #3D5F2B
skinparam ArrowFontSize 11
skinparam BorderColor #3D5F2B
skinparam NoteBackgroundColor #FDE9D3
skinparam NoteBorderColor #A9551A
skinparam class {
  BackgroundColor #FFF8EF
  BorderColor #3D5F2B
  HeaderBackgroundColor #E5EFD8
  AttributeFontSize 11
}
skinparam entity {
  BackgroundColor #FFF8EF
  BorderColor #3D5F2B
}
skinparam component {
  BackgroundColor #FFF8EF
  BorderColor #3D5F2B
}
skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #3D5F2B
}
skinparam database {
  BackgroundColor #E5EFD8
  BorderColor #3D5F2B
}
skinparam actor {
  BackgroundColor #E5EFD8
  BorderColor #3D5F2B
}
skinparam usecase {
  BackgroundColor #FFF8EF
  BorderColor #3D5F2B
}
skinparam activity {
  BackgroundColor #FFF8EF
  BorderColor #3D5F2B
  DiamondBackgroundColor #FDE9D3
  DiamondBorderColor #A9551A
}
skinparam state {
  BackgroundColor #FFF8EF
  BorderColor #3D5F2B
}
skinparam sequence {
  ParticipantBackgroundColor #FFF8EF
  ParticipantBorderColor #3D5F2B
  LifeLineBorderColor #C2A98F
  ActorBackgroundColor #E5EFD8
  ActorBorderColor #3D5F2B
  GroupBackgroundColor #E5EFD8
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #C2A98F
}
