# Nginx de producción. ${DOMINIO} lo reemplaza la imagen oficial al iniciar (envsubst).

# Inicio de sesión: máximo 10 intentos por minuto por IP (rociado de contraseñas y bloqueo de
# cuentas ajenas, auditoría HU-05). El límite por correo lo aplica además la API.
limit_req_zone $binary_remote_addr zone=acceso:10m rate=10r/m;
limit_req_status 429;

server_tokens off;

# HTTP: solo el desafío de Let's Encrypt; todo lo demás va a HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMINIO};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMINIO};

    # Enlace al certificado vigente: Let's Encrypt o el provisional (certificado.sh).
    ssl_certificate /etc/nginx/tls/actual/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/actual/privkey.pem;
    # Configuración «intermedia» de Mozilla: TLS 1.2 y 1.3, compatible con Android 7+.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:TLS:10m;
    ssl_session_tickets off;

    # Permite subir GeoJSON/KML de lotes con muchos vértices.
    client_max_body_size 10m;

    root /usr/share/nginx/html;
    include /etc/nginx/snippets/seguridad.conf;

    location = /api/v1/auth/token {
        limit_req zone=acceso burst=5 nodelay;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    location /api/ {
        include /etc/nginx/snippets/proxy-api.conf;
    }

    # Documentación OpenAPI (entregable para la app móvil). Swagger y ReDoc cargan sus
    # scripts desde cdn.jsdelivr.net, así que tienen su propia CSP.
    location ~ ^/(docs|redoc)$ {
        include /etc/nginx/snippets/seguridad-docs.conf;
        include /etc/nginx/snippets/proxy-api.conf;
    }

    # Archivos con huella en el nombre (Vite): se guardan en caché un año.
    location /assets/ {
        include /etc/nginx/snippets/seguridad.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Aplicación de una sola página: cualquier otra ruta (/mapa, /t/<código>...) sirve index.html.
    location / {
        include /etc/nginx/snippets/seguridad.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
